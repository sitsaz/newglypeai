    {
      "version": "21.0.0",
      "date": "2026-09-18T13:00:00.000000+00:00",
      "changes": [
        "\u2705 \u0631\u0641\u0639 \u06a9\u0627\u0645\u0644 \u0645\u0634\u06a9\u0644 \u0622\u067e\u0644\u0648\u062f \u0641\u0627\u06cc\u0644 JSON \u0627\u0632 \u0627\u0641\u0632\u0648\u0646\u0647 \u06a9\u0631\u0648\u0645 - \u0627\u06a9\u0646\u0648\u0646 \u0641\u0631\u0645\u062a \u062e\u0631\u0648\u062c\u06cc \u0627\u0641\u0632\u0648\u0646\u0647 \u0628\u0647 \u062f\u0631\u0633\u062a\u06cc \u067e\u0631\u062f\u0627\u0632\u0634 \u0645\u06cc\u200c\u0634\u0648\u062f",
        "\u2705 \u0627\u0635\u0644\u0627\u062d domain \u062f\u0631 \u0627\u0641\u0632\u0648\u0646\u0647 \u06a9\u0631\u0648\u0645 - \u062d\u0630\u0641 \u0646\u0642\u0637\u0647 \u0627\u0628\u062a\u062f\u0627\u06cc \u062f\u0627\u0645\u0646\u0647 \u0628\u0631\u0627\u06cc \u0633\u0627\u0632\u06af\u0627\u0631\u06cc \u0628\u0627 \u0633\u0631\u0648\u0631",
        "\u2705 \u0627\u0635\u0644\u0627\u062d sameSite \u0648 expirationDate \u062f\u0631 \u0627\u0641\u0632\u0648\u0646\u0647 \u06a9\u0631\u0648\u0645 \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u0645\u0642\u0627\u062f\u06cc\u0631 null/unspecified",
        "\u2705 \u0631\u0641\u0639 \u062e\u0637\u0627\u06cc '\u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0646\u0627\u0645\u0639\u062a\u0628\u0631' \u062f\u0631 \u067e\u0644\u0627\u06af\u06cc\u0646 \u0648\u0631\u062f\u067e\u0631\u0633 \u0628\u0627 \u062d\u0630\u0641 sanitize_text_field \u0627\u0632 JSON \u0648\u0631\u0648\u062f\u06cc",
        "\u2705 \u0631\u0641\u0639 \u062e\u0637\u0627\u06cc '\u062f\u0627\u062f\u0647\u200c\u0647\u0627\u06cc \u0646\u0627\u0645\u0639\u062a\u0628\u0631' \u062f\u0631 \u0646\u0633\u062e\u0647 standalone \u0628\u0627 \u062f\u0631\u06cc\u0627\u0641\u062a raw POST data",
        "\u2705 \u0627\u0635\u0644\u0627\u062d \u067e\u0631\u062f\u0627\u0632\u0634 \u062f\u0627\u0645\u0646\u0647 \u0628\u0627 ltrim \u0628\u0631\u0627\u06cc \u062d\u0630\u0641 \u0646\u0642\u0637\u0647 \u0627\u0628\u062a\u062f\u0627\u06cc \u0622\u0646 \u062f\u0631 \u0647\u0631 \u062f\u0648 \u0646\u0633\u062e\u0647",
        "\u2705 \u0628\u0647\u0628\u0648\u062f \u067e\u06cc\u0627\u0645\u200c\u0647\u0627\u06cc \u062e\u0637\u0627 \u0628\u0631\u0627\u06cc \u0646\u0645\u0627\u06cc\u0634 \u0628\u062e\u0634\u06cc \u0627\u0632 \u062f\u0627\u062f\u0647 \u062f\u0631\u06cc\u0627\u0641\u062a\u06cc \u062c\u0647\u062a \u062f\u06cc\u0628\u0627\u06af",
        "\u2705 \u06cc\u06a9\u067e\u0627\u0631\u0686\u0647\u200c\u0633\u0627\u0632\u06cc \u06a9\u0627\u0645\u0644 \u0633\u06cc\u0633\u062a\u0645 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u0648 \u0622\u067e\u0644\u0648\u062f \u0633\u0634\u0646 \u062f\u0631 \u0647\u0631 \u062f\u0648 \u0646\u0633\u062e\u0647 standalone \u0648 \u0648\u0631\u062f\u067e\u0631\u0633"
      ]
    },
    {
      "version": "20.0.0",
      "date": "2026-09-18T10:39:21.000000+00:00",
      "changes": [
        "\u0627\u0641\u0632\u0648\u062f\u0646 \u0633\u06cc\u0633\u062a\u0645 \u0627\u062d\u0631\u0627\u0632 \u0647\u0648\u06cc\u062a \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 (\u062b\u0628\u062a\u200c\u0646\u0627\u0645 \u0648 \u0648\u0631\u0648\u062f) \u062f\u0631 \u067e\u0644\u0627\u06af\u06cc\u0646 \u0648\u0631\u062f\u067e\u0631\u0633 \u0648 \u0646\u0633\u062e\u0647 standalone \u0628\u0631\u0627\u06cc \u062c\u0644\u0648\u06af\u06cc\u0631\u06cc \u0627\u0632 \u062a\u062f\u0627\u062e\u0644 \u0633\u0634\u0646\u200c\u0647\u0627",
        "\u067e\u06cc\u0627\u062f\u0647\u200c\u0633\u0627\u0632\u06cc \u0641\u0631\u0645 \u0622\u067e\u0644\u0648\u062f \u0641\u0627\u06cc\u0644 JSON \u062e\u0631\u0648\u062c\u06cc \u0627\u0632 \u0627\u0641\u0632\u0648\u0646\u0647 \u06a9\u0631\u0648\u0645 \u062f\u0631 \u067e\u0644\u0627\u06af\u06cc\u0646 \u0648\u0631\u062f\u067e\u0631\u0633 \u0648 \u0646\u0633\u062e\u0647 standalone",
        "\u0627\u0641\u0632\u0648\u062f\u0646 \u0642\u0627\u0628\u0644\u06cc\u062a \u062d\u0630\u0641 \u0633\u0634\u0646\u200c\u0647\u0627 \u0648 \u06a9\u0648\u06a9\u06cc\u200c\u0647\u0627 \u062f\u0631 \u067e\u0644\u0627\u06af\u06cc\u0646 \u0648\u0631\u062f\u067e\u0631\u0633 (\u0647\u0645\u0627\u0646\u0646\u062f \u0646\u0633\u062e\u0647 standalone)",
        "\u0630\u062e\u06cc\u0631\u0647\u200c\u0633\u0627\u0632\u06cc \u0633\u0634\u0646\u200c\u0647\u0627\u06cc \u06a9\u0627\u0631\u0628\u0631\u0627\u0646 \u0628\u0647 \u0635\u0648\u0631\u062a \u062a\u0641\u06a9\u06cc\u06a9 \u0634\u062f\u0647 \u0628\u0631 \u067e\u0627\u06cc\u0647 \u0646\u0627\u0645 \u06a9\u0627\u0631\u0628\u0631\u06cc",
        "\u0628\u0627\u0632\u0646\u0648\u06cc\u0633\u06cc \u06a9\u0627\u0645\u0644 \u0627\u0641\u0632\u0648\u0646\u0647 \u06a9\u0631\u0648\u0645: \u062d\u0630\u0641 \u0633\u06cc\u0633\u062a\u0645 \u0644\u0627\u06af\u06cc\u0646 \u0648 \u0622\u067e\u0644\u0648\u062f \u062e\u0648\u062f\u06a9\u0627\u0631 - \u0627\u06a9\u0646\u0648\u0646 \u0641\u0642\u0637 \u0641\u0627\u06cc\u0644 JSON \u062e\u0631\u0648\u062c\u06cc \u0645\u06cc\u200c\u062f\u0647\u062f \u06a9\u0647 \u06a9\u0627\u0631\u0628\u0631 \u0628\u0647 \u0635\u0648\u0631\u062a \u062f\u0633\u062a\u06cc \u062f\u0631 \u0627\u06a9\u0627\u0646\u062a \u062e\u0648\u062f \u0622\u067e\u0644\u0648\u062f \u0645\u06cc\u200c\u06a9\u0646\u062f"
      ]
    }
  ]
}