# NewGlype Modernized PHP Host Configuration
# Compatible with Apache 2.4+ and LiteSpeed

<IfModule mod_security.c>
    SecFilterEngine Off
    SecFilterScanPOST Off
</IfModule>

# Ensure UTF-8
AddDefaultCharset UTF-8

# Prevent directory browsing
Options -Indexes

# Set memory and timeout limits if allowed by host
<IfModule mod_php7.c>
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag display_errors Off
</IfModule>

<IfModule mod_php.c>
    php_value max_execution_time 60
    php_value memory_limit 128M
    php_flag display_errors Off
</IfModule>

# Route requests cleanly
DirectoryIndex index.php
