        {
          "version": "20.0.0",
          "date": "2026-09-18T10:38:47.000000+00:00",
          "changes": [
            "افزودن سیستم احراز هویت کاربران (ثبت‌نام و ورود) در پلاگین وردپرس و نسخه standalone برای جلوگیری از تداخل سشن‌ها",
            "پیاده‌سازی فرم آپلود فایل JSON خروجی از افزونه کروم در پلاگین وردپرس و نسخه standalone",
            "افزودن قابلیت حذف سشن‌ها و کوکی‌ها در پلاگین وردپرس (همانند نسخه standalone)",
            "ذخیره‌سازی سشن‌های کاربران به صورت تفکیک شده بر پایه نام کاربری",
            "بازنویسی کامل افزونه کروم: حذف سیستم لاگین و آپلود خودکار - اکنون فقط فایل JSON خروجی می‌دهد که کاربر به صورت دستی در اکانت خود آپلود می‌کند"
          ]
        },
        {
          "version": "19.0.0",
          "date": "2026-09-18T10:25:00.000000+00:00",
